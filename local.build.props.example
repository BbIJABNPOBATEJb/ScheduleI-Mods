<!-- Copy this file to `local.build.props` and fill in paths for your machine. -->
<!-- local.build.props is git-ignored. -->
<Project>
  <PropertyGroup>
    <!-- Main Steam branch (IL2CPP). MelonLoader must be installed and the game launched once. -->
    <Il2CppGamePath>C:\Program Files (x86)\Steam\steamapps\common\Schedule I</Il2CppGamePath>

    <!-- "alternate" Steam branch (Mono). Leave empty if you don't build the Mono version. -->
    <MonoGamePath></MonoGamePath>

    <!-- Optional: separate copies of the game's beta branches for `run-smoke.ps1 -Beta`. -->
    <Il2CppBetaGamePath></Il2CppBetaGamePath>
    <MonoBetaGamePath></MonoBetaGamePath>

    <!-- Copy the built DLL into <game>\Mods after each build. -->
    <AutomateLocalDeployment>true</AutomateLocalDeployment>
  </PropertyGroup>
</Project>
