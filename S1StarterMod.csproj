<Project Sdk="Microsoft.NET.Sdk">
  <!-- Machine-specific game paths (git-ignored). See local.build.props.example. -->
  <Import Project="local.build.props" Condition="Exists('local.build.props')" />

  <PropertyGroup>
    <!-- Name/version/author shown in MelonLoader live in src/ModInfo.cs -->
    <ModName>S1StarterMod</ModName>

    <Configurations>Il2Cpp;Mono</Configurations>
    <Configuration Condition="'$(Configuration)' == ''">Il2Cpp</Configuration>
    <Platforms>AnyCPU</Platforms>
    <RootNamespace>$(ModName)</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Optimize>true</Optimize>
    <DebugType>embedded</DebugType>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AutomateLocalDeployment Condition="'$(AutomateLocalDeployment)' == ''">false</AutomateLocalDeployment>
  </PropertyGroup>

  <!-- Main Steam branch: IL2CPP, MelonLoader net6 runtime -->
  <PropertyGroup Condition="'$(Configuration)' == 'Il2Cpp'">
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>$(ModName)_Il2Cpp</AssemblyName>
    <DefineConstants>$(DefineConstants);IL2CPP</DefineConstants>
    <GamePath>$(Il2CppGamePath)</GamePath>
    <MelonLoaderPath>$(GamePath)\MelonLoader\net6</MelonLoaderPath>
    <GameAssembliesPath>$(GamePath)\MelonLoader\Il2CppAssemblies</GameAssembliesPath>
  </PropertyGroup>

  <!-- "alternate" Steam branch: Mono, MelonLoader net35 runtime -->
  <PropertyGroup Condition="'$(Configuration)' == 'Mono'">
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>$(ModName)_Mono</AssemblyName>
    <DefineConstants>$(DefineConstants);MONO</DefineConstants>
    <GamePath>$(MonoGamePath)</GamePath>
    <MelonLoaderPath>$(GamePath)\MelonLoader\net35</MelonLoaderPath>
    <GameAssembliesPath>$(GamePath)\Schedule I_Data\Managed</GameAssembliesPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="MelonLoader" HintPath="$(MelonLoaderPath)\MelonLoader.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(MelonLoaderPath)\0Harmony.dll" Private="false" />
  </ItemGroup>

  <!-- IL2CPP: every generated proxy assembly is prefixed or Unity-owned, so referencing all of them is safe. -->
  <ItemGroup Condition="'$(Configuration)' == 'Il2Cpp'">
    <Reference Include="$(MelonLoaderPath)\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(MelonLoaderPath)\Il2CppInterop.Common.dll" Private="false" />
    <Reference Include="$(GameAssembliesPath)\*.dll" Private="false" />
  </ItemGroup>

  <!-- Mono: Managed also contains the BCL (mscorlib, System.*), which must not be referenced. -->
  <ItemGroup Condition="'$(Configuration)' == 'Mono'">
    <Reference Include="$(GameAssembliesPath)\Assembly-CSharp.dll" Private="false" />
    <Reference Include="$(GameAssembliesPath)\ScheduleOne.Core.dll" Private="false" />
    <Reference Include="$(GameAssembliesPath)\FishNet.Runtime.dll" Private="false" />
    <Reference Include="$(GameAssembliesPath)\UnityEngine*.dll" Private="false" />
    <Reference Include="$(GameAssembliesPath)\Unity.TextMeshPro.dll" Private="false" />
  </ItemGroup>

  <Target Name="ValidateGamePaths" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(Configuration)' != 'Il2Cpp' and '$(Configuration)' != 'Mono'"
           Text="Unknown configuration '$(Configuration)'. Use -c Il2Cpp or -c Mono." />
    <Error Condition="'$(GamePath)' == ''"
           Text="Game path for '$(Configuration)' is not set. Copy local.build.props.example to local.build.props and fill it in." />
    <Error Condition="!Exists('$(MelonLoaderPath)\MelonLoader.dll')"
           Text="MelonLoader not found in '$(MelonLoaderPath)'. Install MelonLoader into the game folder." />
    <Error Condition="!Exists('$(GameAssembliesPath)\Assembly-CSharp.dll')"
           Text="Game assemblies not found in '$(GameAssembliesPath)'. For IL2CPP, launch the game once with MelonLoader to generate them." />
  </Target>

  <Target Name="DeployToGame" AfterTargets="Build" Condition="'$(AutomateLocalDeployment)' == 'true'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GamePath)\Mods" />
    <Message Importance="high" Text="Deployed $(TargetFileName) -> $(GamePath)\Mods" />
  </Target>
</Project>
